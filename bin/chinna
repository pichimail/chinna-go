# ═══════════════════════════════════════════════════════════════
# COMMAND: publish (push update to GitHub → auto-updates friends)
# ═══════════════════════════════════════════════════════════════
cmd_publish() {
    banner
    echo -e "   ${BOLD}${ORANGE}📤 PUBLISH UPDATE${RESET}"; echo ""
    local token="${GITHUB_TOKEN:-}"
    [ -z "$token" ] && { fail "GITHUB_TOKEN not set. Run: chinna config github"; return 1; }

    # Bump version
    local current="$CHINNA_VERSION"
    local parts=(${current//./ })
    local new_patch=$(( ${parts[2]:-0} + 1 ))
    local new_ver="${parts[0]}.${parts[1]}.$new_patch"

    info "Bumping $current → $new_ver"

    # Update VERSION file
    local chinna_src="$CHINNA_HOME/bin/chinna"
    echo "$new_ver" > "$CHINNA_HOME/VERSION"
    sed -i '' "s/CHINNA_VERSION=\"$current\"/CHINNA_VERSION=\"$new_ver\"/" "$chinna_src" 2>/dev/null

    # Push to GitHub via API
    local repo="$CHINNA_REPO"
    local content
    content=$(base64 < "$chinna_src" | tr -d '\n')

    # Get current SHA for update
    local sha
    sha=$(curl -s -H "Authorization: token $token" \
        "https://api.github.com/repos/$repo/contents/bin/chinna" 2>/dev/null | \
        jq -r '.sha // empty')

    local payload
    payload=$(jq -n \
        --arg msg "chore: release v$new_ver" \
        --arg content "$content" \
        --arg sha "$sha" \
        '{message: $msg, content: $content, sha: $sha}')

    local result
    result=$(curl -s -X PUT \
        -H "Authorization: token $token" \
        -H "Content-Type: application/json" \
        "https://api.github.com/repos/$repo/contents/bin/chinna" \
        -d "$payload" 2>/dev/null)

    if echo "$result" | jq -e '.content.name' >/dev/null 2>&1; then
        local version_sha version_payload version_result
        version_sha=$(curl -s -H "Authorization: token $token" \
            "https://api.github.com/repos/$repo/contents/VERSION" 2>/dev/null | \
            jq -r '.sha // empty')
        version_payload=$(jq -n \
            --arg msg "chore: release v$new_ver" \
            --arg content "$(printf '%s' "$new_ver" | base64 | tr -d '\n')" \
            --arg sha "$version_sha" \
            '{message: $msg, content: $content, sha: $sha}')
        version_result=$(curl -s -X PUT \
            -H "Authorization: token $token" \
            -H "Content-Type: application/json" \
            "https://api.github.com/repos/$repo/contents/VERSION" \
            -d "$version_payload" 2>/dev/null)

        ok "Published v$new_ver to github.com/$repo"
        info "All friends auto-update within 24h"
        chinna_ok_toast "Chinna Published" "v$new_ver live — friends auto-update in 24h" 2>/dev/null || true
    else
        fail "Publish failed"
        echo "$result" | jq '.message' 2>/dev/null
    fi
    echo ""
}

