#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════╗
# ║  CHINNA v6 — Sarcastic Mac Sidekick                         ║
# ║  Telugu · Hindi · English · Tinglish                        ║
# ║  github.com/pichimail/chinna-go                             ║
# ╚══════════════════════════════════════════════════════════════╝
set -uo pipefail

CHINNA_VERSION="6.0.0"
CHINNA_REPO="pichimail/chinna-go"
CHINNA_HOME="${CHINNA_HOME:-$HOME/.chinna}"
CHINNA_CONFIG="$CHINNA_HOME/config"
CHINNA_LIB="$CHINNA_HOME/lib"

mkdir -p "$CHINNA_HOME" "$CHINNA_LIB"
if [ -f "$CHINNA_HOME/VERSION" ]; then
    CHINNA_VERSION="$(tr -d '[:space:]' < "$CHINNA_HOME/VERSION")"
fi
if [ -f "$CHINNA_CONFIG" ]; then
    # Older/user-edited config files may reference unset vars; do not hard-fail startup.
    set +u
    source "$CHINNA_CONFIG"
    set -u
fi

# ─── Source libs ───────────────────────────────────────────────
safe_source_lib() {
    local lib_path="$1"
    local lib_name
    lib_name="$(basename "$lib_path")"
    [ -f "$lib_path" ] || return 0

    if ! bash -n "$lib_path" >/dev/null 2>&1; then
        warn "Skipping broken library: $lib_name"
        return 0
    fi

    # shellcheck source=/dev/null
    source "$lib_path"
}

for lib in notify lang stack voice daemon config clean registry plugins; do
    safe_source_lib "$CHINNA_LIB/${lib}.sh"
done

# Load user config + models on every run
chinna_load_env 2>/dev/null || true
chinna_write_defaults 2>/dev/null || true

# ─── Colors ───────────────────────────────────────────────────
if [ -t 1 ]; then
    R=$'\033[0;31m'; G=$'\033[0;32m'; Y=$'\033[0;33m'; B=$'\033[0;34m'
    M=$'\033[0;35m'; C=$'\033[0;36m'; W=$'\033[1;37m'; D=$'\033[2m'
    BOLD=$'\033[1m'; RESET=$'\033[0m'
    ORANGE=$'\033[38;5;208m'; PINK=$'\033[38;5;205m'; TEAL=$'\033[38;5;51m'
    GREEN=$'\033[38;5;46m'
else
    R='' G='' Y='' B='' M='' C='' W='' D='' BOLD='' RESET=''
    ORANGE='' PINK='' TEAL='' GREEN=''
fi

# ─── UI helpers ───────────────────────────────────────────────
ok()    { echo -e "  ${G}✓${RESET} $*"; }
warn()  { echo -e "  ${Y}!${RESET} $*"; }
fail()  { echo -e "  ${R}✗${RESET} $*"; }
info()  { echo -e "  ${C}ℹ${RESET} $*"; }
sep()   { echo -e "  ${D}──────────────────────────────────────${RESET}"; }

section() {
    echo ""
    echo -e "  ${TEAL}▶ $*${RESET}"
    sep
}

progress_bar() {
    local msg="$1" pct="${2:-0}" width=28
    local filled=$(( pct * width / 100 ))
    local bar="" color="$G"
    [ "$pct" -gt 70 ] && color="$Y"
    [ "$pct" -gt 85 ] && color="$R"
    for ((i=0;i<filled;i++)); do bar+="█"; done
    for ((i=filled;i<width;i++)); do bar+="░"; done
    printf "\r  ${color}%s${RESET} %3d%%  %-30s" "$bar" "$pct" "$msg"
}

disk_bar() {
    local pct
    pct=$(df /System/Volumes/Data 2>/dev/null | awk 'NR==2{gsub(/%/,"",$5); print $5}' || \
          df / | awk 'NR==2{gsub(/%/,"",$5); print $5}')
    local used free total
    used=$(df -h /System/Volumes/Data 2>/dev/null | awk 'NR==2{print $3}' || df -h / | awk 'NR==2{print $3}')
    free=$(df -h /System/Volumes/Data 2>/dev/null | awk 'NR==2{print $4}' || df -h / | awk 'NR==2{print $4}')
    progress_bar "$used used · $free free" "${pct:-0}"
    echo ""
}

spinner() {
    local pid=$1 msg="${2:-Working}"
    local s='⣾⣽⣻⢿⡿⣟⣯⣷' i=0
    tput civis 2>/dev/null
    while kill -0 "$pid" 2>/dev/null; do
        i=$(( (i+1) % 8 ))
        printf "\r  ${ORANGE}%s${RESET}  ${D}%s${RESET}   " "${s:$i:1}" "$msg"
        sleep 0.1
    done
    tput cnorm 2>/dev/null
    printf "\r%-70s\r" " "
}

disk_usage() {
    df -h /System/Volumes/Data 2>/dev/null | awk 'NR==2{print $3" used · "$4" free · "$5" full"}' \
    || df -h / | awk 'NR==2{print $3" used · "$4" free · "$5" full"}'
}

# ─── Sarcastic commentary ─────────────────────────────────────
SARCASM=(
    "Your disk was crying. I heard it from Hyderabad."
    "47 node_modules folders. I'm not judging. I am judging."
    "More cache than a government office has files."
    "Your Mac has been running this slow and you said nothing?"
    "Found build artifacts from projects you swore you'd finish."
    "Ollama models: downloaded, forgotten, 8GB gone. Classic."
    "Docker images older than your last committed relationship."
    "RAM hogs found. Chrome, obviously. Always Chrome."
    "Your Downloads folder is a cemetery. Time to cremate."
    "3 venvs in folders you don't remember creating. Respect."
    "dist/ folders everywhere. Build once, forget forever."
    "Your Mac thermals were screaming. I intervened."
    "Found 'final_final_v3_REAL.zip' in Downloads. Deleting."
    "node_modules untouched since 2024. Gone. You're welcome."
    "Even your trash had trash inside it. Deep."
)

taunt() { echo -e "  ${D}${SARCASM[$RANDOM % ${#SARCASM[@]}]}${RESET}"; }

# ─── ASCII Art ────────────────────────────────────────────────
banner() {
    clear
    echo ""
    echo -e "   ${ORANGE}╔═══════════════════════════════════════╗${RESET}"
    echo -e "   ${ORANGE}║${RESET}  ${BOLD}C H I N N A${RESET}  ${D}v${CHINNA_VERSION}${RESET}                    ${ORANGE}║${RESET}"
    echo -e "   ${ORANGE}║${RESET}  ${D}your sarcastic mac sidekick${RESET}           ${ORANGE}║${RESET}"
    echo -e "   ${ORANGE}║${RESET}  ${D}telugu · hindi · english · tinglish${RESET}   ${ORANGE}║${RESET}"
    echo -e "   ${ORANGE}╚═══════════════════════════════════════╝${RESET}"
    echo ""
    echo -ne "   ${D}Disk: ${RESET}"
    disk_bar
    echo ""
}

# ─── Ensure dep ───────────────────────────────────────────────
ensure_dep() {
    local cmd="$1" pkg="${2:-$1}"
    if ! command -v "$cmd" >/dev/null 2>&1; then
        warn "$cmd not installed — installing $pkg..."
        brew install "$pkg" >/dev/null 2>&1 && ok "$pkg installed" || { fail "brew install $pkg failed"; return 1; }
    fi
}

version_gt() {
    [ "$1" != "$2" ] || return 1
    [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" = "$1" ]
}

remote_version() {
    curl -fsSL "https://raw.githubusercontent.com/${CHINNA_REPO}/main/VERSION" 2>/dev/null | tr -d '[:space:]'
}

resolve_installer() {
    local local_installer home_installer tmp_installer
    local_installer="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/install/install.sh"
    if [ -x "$local_installer" ]; then
        printf '%s\n' "$local_installer"
        return 0
    fi

    home_installer="$CHINNA_HOME/install/install.sh"
    if [ -x "$home_installer" ]; then
        printf '%s\n' "$home_installer"
        return 0
    fi

    tmp_installer="$(mktemp -t chinna-install.XXXXXX)"
    if curl -fsSL "https://raw.githubusercontent.com/${CHINNA_REPO}/main/install/install.sh" -o "$tmp_installer" 2>/dev/null; then
        chmod +x "$tmp_installer"
        printf '%s\n' "$tmp_installer"
        return 0
    fi

    rm -f "$tmp_installer" 2>/dev/null || true
    return 1
}

resolve_remote_installer() {
    local tmp_installer
    tmp_installer="$(mktemp -t chinna-install.XXXXXX)"
    if curl -fsSL "https://raw.githubusercontent.com/${CHINNA_REPO}/main/install/install.sh" -o "$tmp_installer" 2>/dev/null; then
        chmod +x "$tmp_installer"
        printf '%s\n' "$tmp_installer"
        return 0
    fi
    rm -f "$tmp_installer" 2>/dev/null || true
    return 1
}

apply_update() {
    local remote_ver="$1" installer rc=0
    installer="$(resolve_remote_installer)" || installer="$(resolve_installer)" || { fail "Installer unavailable"; return 1; }

    info "Applying update to v${remote_ver}..."
    info "User data, configs, and API keys will be preserved."

    bash "$installer" update "$remote_ver"
    rc=$?

    rm -f "$CHINNA_HOME/update_prompted_version" 2>/dev/null || true

    case "$installer" in
        "$CHINNA_HOME"/*|*"$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"/*) ;;
        *) rm -f "$installer" 2>/dev/null || true ;;
    esac

    return "$rc"
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: clean
# ═══════════════════════════════════════════════════════════════
cmd_clean() {
    banner
    echo -e "   ${BOLD}${ORANGE}🧹 DEEP CLEAN${RESET}"
    taunt; echo ""
    echo -e "   ${D}Before:${RESET} $(disk_usage)"; echo ""

    _clean_step() {
        local n="$1" total="$2" msg="$3"
        local pct=$(( n * 100 / total ))
        progress_bar "[$n/$total] $msg" "$pct"
    }

    local T=12

    _clean_step 1 $T "System temp folders"
    sudo rm -rf /private/var/folders/*/T/* 2>/dev/null
    sudo rm -rf /private/var/folders/*/C/* 2>/dev/null; ok " System temp cleared"

    _clean_step 2 $T "User caches"
    rm -rf ~/Library/Caches/* 2>/dev/null
    sudo rm -rf /Library/Caches/* 2>/dev/null; ok " User caches cleared"

    _clean_step 3 $T "Electron app caches"
    for app in "Google/Chrome" "Claude" "Code" "Windsurf" "Cursor" "Perplexity" "Codex" "com.openai.chat" "cloud-code" "Nekta AI Marketing Studio"; do
        for sub in "Cache" "Code Cache" "GPUCache" "logs" "Service Worker/CacheStorage" "CachedData" "ShaderCache" "GrShaderCache" "DawnGraphiteCache" "DawnWebGPUCache"; do
            rm -rf "$HOME/Library/Application Support/$app/$sub" 2>/dev/null
            rm -rf "$HOME/Library/Application Support/$app"/*/"$sub" 2>/dev/null
        done
    done; ok " Electron caches nuked"

    _clean_step 4 $T "Xcode & Simulators"
    rm -rf ~/Library/Developer/Xcode/DerivedData/* 2>/dev/null
    rm -rf ~/Library/Developer/Xcode/Archives/* 2>/dev/null
    rm -rf ~/Library/Developer/Xcode/iOS\ DeviceSupport/* 2>/dev/null
    rm -rf ~/Library/Developer/CoreSimulator/Caches/* 2>/dev/null
    xcrun simctl delete unavailable 2>/dev/null; ok " Xcode bloat removed"

    _clean_step 5 $T "Package manager caches"
    npm cache clean --force >/dev/null 2>&1 || true
    pnpm store prune >/dev/null 2>&1 || true
    yarn cache clean >/dev/null 2>&1 || true
    rm -rf ~/.bun/install/cache 2>/dev/null
    rm -rf ~/Library/Caches/CocoaPods 2>/dev/null
    rm -rf ~/.gradle/caches ~/.gradle/daemon ~/.gradle/wrapper/dists 2>/dev/null
    rm -rf ~/Library/Caches/pip ~/.cache/pip 2>/dev/null
    brew cleanup -s --prune=all >/dev/null 2>&1 || true; ok " npm/pnpm/yarn/bun/pip/brew/gradle clean"

    _clean_step 6 $T "Docker reset"
    osascript -e 'quit app "Docker"' 2>/dev/null; sleep 2
    rm -rf ~/Library/Containers/com.docker.docker/Data/vms/* 2>/dev/null
    rm -rf ~/Library/Group\ Containers/group.com.docker/* 2>/dev/null
    docker system prune -af --volumes >/dev/null 2>&1 || true; ok " Docker cleared"

    _clean_step 7 $T "Build artifacts"
    local bcount=0
    for base in ~/Documents ~/Desktop ~/Developer ~/repos ~/code ~/projects ~/Sites ~/dev ~/Documents/GitHub; do
        [ -d "$base" ] || continue
        while IFS= read -r d; do
            rm -rf "$d" 2>/dev/null && bcount=$((bcount+1))
        done < <(find "$base" -maxdepth 6 -type d \
            \( -name ".next" -o -name "dist" -o -name "out" -o -name ".expo" \
               -o -name ".turbo" -o -name ".vercel" -o -name ".parcel-cache" \
               -o -name ".nuxt" -o -name ".svelte-kit" \) \
            -not -path "*/node_modules/*" -prune 2>/dev/null)
    done; ok " $bcount build folders deleted"

    _clean_step 8 $T "Old node_modules (>7 days untouched)"
    local nm_del=0 nm_keep=0
    local cutoff=$(($(date +%s) - 604800))
    for base in ~/Documents ~/Desktop ~/Developer ~/repos ~/code ~/projects ~/Sites ~/dev; do
        [ -d "$base" ] || continue
        while IFS= read -r nm; do
            local proj=$(dirname "$nm")
            local lm=$(stat -f "%m" "$proj" 2>/dev/null || echo 0)
            if [ "$lm" -lt "$cutoff" ]; then
                rm -rf "$nm" 2>/dev/null && nm_del=$((nm_del+1))
            else
                nm_keep=$((nm_keep+1))
            fi
        done < <(find "$base" -maxdepth 6 -type d -name "node_modules" \
            -not -path "*/node_modules/*/node_modules*" 2>/dev/null)
    done; ok " $nm_del old node_modules removed, $nm_keep active kept"

    _clean_step 9 $T "Python venvs & pycache"
    find ~ -maxdepth 7 -type d \
        \( -name "__pycache__" -o -name ".venv" -o -name "venv" \
           -o -name ".pytest_cache" -o -name ".mypy_cache" \) \
        -not -path "*/node_modules/*" -prune -exec rm -rf {} + 2>/dev/null; ok " Python clutter removed"

    _clean_step 10 $T "Logs & crash reports"
    sudo rm -rf /private/var/log/*.log* 2>/dev/null
    rm -rf ~/Library/Logs/* 2>/dev/null
    sudo rm -rf /Library/Logs/DiagnosticReports/* 2>/dev/null
    rm -rf ~/Library/Logs/DiagnosticReports/* 2>/dev/null
    sudo rm -f /private/var/vm/sleepimage 2>/dev/null; ok " Logs cleared"

    _clean_step 11 $T "Ollama models"
    if [ -d ~/.ollama/models/blobs ] && [ -n "$(ls -A ~/.ollama/models/blobs 2>/dev/null)" ]; then
        local osiz=$(du -sh ~/.ollama/models 2>/dev/null | cut -f1)
        rm -rf ~/.ollama/models/blobs/* ~/.ollama/models/manifests/* 2>/dev/null
        ok " Ollama cleared ($osiz) — repull: ollama pull <model>"
    else
        ok " No Ollama models to clear"
    fi

    _clean_step 12 $T "Snapshots, trash & RAM"
    for snap in $(tmutil listlocalsnapshotdates / 2>/dev/null | grep -E '^[0-9]{4}-'); do
        sudo tmutil deletelocalsnapshots "$snap" >/dev/null 2>&1
    done
    sudo diskutil apfs deleteAllSnapshots / >/dev/null 2>&1 || true
    osascript -e 'tell application "Finder" to empty trash' 2>/dev/null &
    sudo purge 2>/dev/null; ok " Snapshots deleted, trash emptied, RAM purged"

    echo ""; sep
    echo -e "   ${G}✓ DONE.${RESET} $(disk_usage)"
    echo -e "   ${Y}⚠ REBOOT${RESET} for System Data to recalculate"
    chinna_ok_toast "Deep Clean Done" "$(disk_usage) — Reboot for full effect" 2>/dev/null || true
    echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: purge
# ═══════════════════════════════════════════════════════════════
cmd_purge() {
    banner
    echo -e "   ${BOLD}${PINK}🧠 RAM PURGE${RESET}"; echo ""
    local before
    before=$(vm_stat 2>/dev/null | awk '/Pages free/{printf "%.0f MB", $3*16384/1048576}')
    info "Before: $before free"
    sudo purge; sleep 1
    local after
    after=$(vm_stat 2>/dev/null | awk '/Pages free/{printf "%.0f MB", $3*16384/1048576}')
    ok "After:  $after free"
    chinna_ok_toast "RAM Purged" "Free: $after" 2>/dev/null || true
    echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: scan
# ═══════════════════════════════════════════════════════════════
cmd_scan() {
    banner
    echo -e "   ${BOLD}${TEAL}🔬 DISK SCAN${RESET}"; echo ""

    section "Disk volumes"
    df -h | grep -E "^/dev|Filesystem" | column -t

    section "Top 10 — Application Support"
    du -sh ~/Library/Application\ Support/* 2>/dev/null | sort -hr | head -10 | \
        awk '{printf "  %-8s %s\n", $1, $2}'

    section "Top 10 — Containers"
    du -sh ~/Library/Containers/* 2>/dev/null | sort -hr | head -10 | \
        awk '{printf "  %-8s %s\n", $1, $2}'

    section "Top 10 — Caches"
    du -sh ~/Library/Caches/* 2>/dev/null | sort -hr | head -10 | \
        awk '{printf "  %-8s %s\n", $1, $2}'

    section "Files >500MB in home"
    find ~ -type f -size +500M -not -path "*/.Trash/*" 2>/dev/null | head -8 | \
        while read -r f; do echo "  $(du -h "$f" 2>/dev/null | cut -f1)  $f"; done

    section "Ollama models"
    [ -d ~/.ollama/models ] && du -sh ~/.ollama/models 2>/dev/null || info "None installed"

    section "APFS snapshots"
    sudo tmutil listlocalsnapshots / 2>/dev/null | head -5 || info "None"

    echo ""
    chinna_info_toast "Scan Complete" "Check terminal for results" 2>/dev/null || true
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: status (live dashboard)
# ═══════════════════════════════════════════════════════════════
cmd_status() {
    banner
    echo -e "   ${BOLD}${TEAL}📊 LIVE STATUS${RESET}"; echo ""

    section "Disk"
    disk_bar

    section "Memory"
    vm_stat 2>/dev/null | awk '
        /Pages free/     {free=$3*16384/1048576}
        /Pages active/   {active=$3*16384/1048576}
        /Pages inactive/ {inactive=$3*16384/1048576}
        /Pages wired/    {wired=$4*16384/1048576}
        END {
            printf "  Free: %.0f MB  Active: %.0f MB  Inactive: %.0f MB  Wired: %.0f MB\n",
            free, active, inactive, wired
        }'

    section "CPU (top processes)"
    ps aux | sort -k3 -rn | head -6 | awk '{printf "  %-6s %-5s %-5s %s\n", $1, $3"%", $4"%", $11}'

    section "Network"
    local ip
    ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo "disconnected")
    info "Local IP: $ip"

    section "Chinna daemon"
    if launchctl list 2>/dev/null | grep -q "com.chinna.daemon"; then
        ok "Running in background"
    else
        warn "Not running. Start with: chinna start"
    fi

    section "Tracked Projects"
    if [ -f "$CHINNA_HOME/state/projects.json" ]; then
        python3 - "$CHINNA_HOME/state/projects.json" <<'PY'
import json, sys, os
from datetime import datetime
f = sys.argv[1]
try:
    with open(f) as fp: data = json.load(fp)
except: data = {"projects": {}}
projs = data.get("projects", {})
print(f"  {len(projs)} projects in registry")
for path, info in sorted(projs.items(), key=lambda x: -x[1].get("updated",0))[:3]:
    short = path.replace(os.path.expanduser("~"), "~")
    note = info.get("notes","")[:50]
    tags = " ".join(f"#{t}" for t in info.get("tags",[])[:2])
    print(f"    • {info.get('stack','?'):12} {short}  {tags}")
    if note: print(f"      {note}")
PY
    else
        info "No projects registered"
    fi
    echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: dupes
# ═══════════════════════════════════════════════════════════════
cmd_dupes() {
    banner
    echo -e "   ${BOLD}${TEAL}🔍 DUPLICATE HUNTER${RESET}"; echo ""
    ensure_dep fdupes fdupes || return 1
    local target="${1:-$HOME/Downloads}"
    info "Scanning: $target"
    local out="/tmp/chinna_dupes_$$.txt"
    fdupes -r -S "$target" > "$out" 2>/dev/null
    local count
    count=$(grep -c "bytes" "$out" 2>/dev/null || echo 0)
    if [ "$count" = "0" ]; then
        ok "No duplicates found in $target"
        rm -f "$out"; return 0
    fi
    cat "$out"; echo ""
    echo -ne "  ${Y}Delete duplicates (keeps first copy)? [y/N]:${RESET} "
    read -r yn
    [[ "$yn" =~ ^[Yy]$ ]] && fdupes -rdN "$target" 2>/dev/null && ok "Duplicates removed"
    rm -f "$out"
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: kill (RAM hog killer)
# ═══════════════════════════════════════════════════════════════
cmd_kill() {
    banner
    echo -e "   ${BOLD}${R}💀 RAM HOG KILLER${RESET}"; echo ""
    echo -e "   ${D}Top memory consumers:${RESET}"; echo ""
    ps aux | sort -k4 -rn | head -10 | \
        awk '{printf "  %-5s %-5s %-30s\n", $2, $4"%", substr($11,1,30)}'
    echo ""
    echo -ne "  ${Y}Kill a process? Enter PID (or ENTER to skip):${RESET} "
    read -r pid
    if [ -n "$pid" ] && [[ "$pid" =~ ^[0-9]+$ ]]; then
        kill -9 "$pid" 2>/dev/null && ok "Process $pid killed" || fail "Could not kill $pid"
    fi
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: ports
# ═══════════════════════════════════════════════════════════════
cmd_ports() {
    banner
    echo -e "   ${BOLD}${TEAL}🔌 ACTIVE PORTS${RESET}"; echo ""
    lsof -iTCP -sTCP:LISTEN -n -P 2>/dev/null | \
        awk 'NR>1{printf "  %-8s %-20s %-30s\n", $2, $9, $1}' | \
        sort -u | head -20
    echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: wifi
# ═══════════════════════════════════════════════════════════════
cmd_wifi() {
    banner
    echo -e "   ${BOLD}${TEAL}📶 WIFI DIAGNOSTICS${RESET}"; echo ""

    local ssid
    ssid=$(/System/Library/PrivateFrameworks/Apple80211.framework/Versions/Current/Resources/airport -I 2>/dev/null | awk '/ SSID/{print $2}' || echo "unknown")
    info "SSID: $ssid"
    info "Local IP: $(ipconfig getifaddr en0 2>/dev/null || echo 'N/A')"

    section "Ping test (google.com)"
    ping -c 4 google.com 2>/dev/null | tail -2

    section "DNS resolution"
    local t1=$(($(date +%s%N)/1000000))
    host google.com >/dev/null 2>&1
    local t2=$(($(date +%s%N)/1000000))
    info "DNS lookup: $((t2-t1))ms"

    section "Speed estimate (100KB download)"
    local speed
    speed=$(curl -o /dev/null -s -w "%{speed_download}" https://speed.cloudflare.com/__down?bytes=100000 2>/dev/null)
    if [ -n "$speed" ]; then
        local mbps=$(echo "scale=2; $speed/131072" | bc 2>/dev/null || echo "?")
        info "Download: ~${mbps} Mbps"
    fi
    echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: remind
# ═══════════════════════════════════════════════════════════════
cmd_remind() {
    local delay="${1:-5m}"
    shift
    local msg="${*:-Chinna reminder}"
    local seconds=300

    case "$delay" in
        *s) seconds="${delay%s}" ;;
        *m) seconds=$(( ${delay%m} * 60 )) ;;
        *h) seconds=$(( ${delay%h} * 3600 )) ;;
        [0-9]*) seconds="$delay" ;;
    esac

    ok "Reminder set for ${delay}: \"$msg\""
    (
        sleep "$seconds"
        osascript -e "display notification \"$msg\" with title \"⏰ Chinna Reminder\" sound name \"Ping\"" 2>/dev/null
        osascript -e "display alert \"⏰ Chinna Reminder\" message \"$msg\"" 2>/dev/null
    ) &
    disown
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: brew (dev setup)
# ═══════════════════════════════════════════════════════════════
cmd_brew() {
    banner
    echo -e "   ${BOLD}${ORANGE}🍺 DEV SETUP${RESET}"; echo ""

    if ! command -v brew >/dev/null 2>&1; then
        info "Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null || true
    else
        ok "Homebrew ready"
    fi

    local pkgs=(node python@3.12 pnpm bun jq fdupes gh git wget tree htop ffmpeg imagemagick sox curl bc)
    local casks=(visual-studio-code cursor warp rectangle)

    section "CLI tools"
    for pkg in "${pkgs[@]}"; do
        if brew list "$pkg" >/dev/null 2>&1; then
            ok "$pkg"
        else
            printf "  ${ORANGE}↻${RESET} Installing $pkg..."
            brew install "$pkg" >/dev/null 2>&1 \
                && printf "\r  ${G}✓${RESET} $pkg installed          \n" \
                || printf "\r  ${Y}!${RESET} $pkg skipped             \n"
        fi
    done

    section "GUI apps"
    for cask in "${casks[@]}"; do
        if brew list --cask "$cask" >/dev/null 2>&1; then
            ok "$cask"
        else
            printf "  ${ORANGE}↻${RESET} Installing $cask..."
            brew install --cask "$cask" >/dev/null 2>&1 \
                && printf "\r  ${G}✓${RESET} $cask installed          \n" \
                || printf "\r  ${Y}!${RESET} $cask skipped             \n"
        fi
    done

    ok "Dev environment ready! Restart your terminal."
    chinna_ok_toast "Dev Setup Done" "node, python, pnpm, bun, VS Code all ready" 2>/dev/null || true
    echo ""
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: free / pro (AI chat with streaming)
# ═══════════════════════════════════════════════════════════════
_or_chat() {
    local model="$1"; shift
    local prompt="$*"
    ensure_dep jq jq || return 1
    local api_key="${OPENROUTER_API_KEY:-}"
    [ -z "$api_key" ] && { fail "OPENROUTER_API_KEY not set. Run: chinna config"; return 1; }
    [ -z "$prompt" ] && { echo -ne "  ${C}You:${RESET} "; read -r prompt; }
    echo ""
    echo -e "  ${D}$model${RESET}"
    echo -ne "  ${ORANGE}Chinna:${RESET} "
    curl -s -N "https://openrouter.ai/api/v1/chat/completions" \
        -H "Authorization: Bearer $api_key" \
        -H "Content-Type: application/json" \
        -H "X-Title: Chinna CLI" \
        -d "$(jq -n --arg m "$model" --arg p "$prompt" \
            '{model:$m,stream:true,max_tokens:1000,messages:[{role:"user",content:$p}]}')" | \
    while IFS= read -r line; do
        line="${line#data: }"
        [ "$line" = "[DONE]" ] && break
        [ -z "$line" ] && continue
        local c
        c=$(echo "$line" | jq -r '.choices[0].delta.content // empty' 2>/dev/null)
        [ -n "$c" ] && printf '%s' "$c"
    done
    echo ""; echo ""
}

cmd_free() { _or_chat "${CHINNA_FREE_MODEL:-meta-llama/llama-3.3-70b-instruct:free}" "$@"; }
cmd_pro()  { _or_chat "${CHINNA_PRO_MODEL:-anthropic/claude-sonnet-4-5}" "$@"; }

# ═══════════════════════════════════════════════════════════════
# COMMAND: listen (voice mode)
# ═══════════════════════════════════════════════════════════════
cmd_listen() {
    banner
    echo -e "   ${BOLD}${PINK}🎤 VOICE MODE${RESET}"; echo ""
    echo -e "   ${D}SPACE SPACE = toggle | ENTER = record | q = quit${RESET}"; echo ""

    if ! command -v sox >/dev/null 2>&1; then
        warn "Installing sox (needed for mic)..."
        brew install sox >/dev/null 2>&1
    fi

    while true; do
        voice_interactive_loop 2>/dev/null || voice_push_to_talk
        local transcript="${VOICE_TRANSCRIPT:-}"
        [ -z "$transcript" ] && break

        echo -e "   ${C}Detected:${RESET} $transcript"
        local intent
        intent=$(resolve_intent "$transcript" 2>/dev/null || echo "unknown")

        if [ "$intent" = "unknown" ]; then
            cmd_pro "$transcript"
        else
            dispatch_intent "$intent" "$transcript"
        fi

        echo ""
        echo -ne "   ${D}Continue voice mode? [Y/n]:${RESET} "
        read -r cont
        [[ "$cont" =~ ^[Nn]$ ]] && break
        VOICE_TRANSCRIPT=""
    done
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: preview
# ═══════════════════════════════════════════════════════════════
cmd_preview() {
    local target="${1:-$(pwd)}"
    banner
    echo -e "   ${BOLD}${PINK}🌐 PREVIEW${RESET}"; echo ""
    info "Serving: $target on :8765"
    info "Press Ctrl+C to stop"
    if [ -f "$target" ]; then
        cd "$(dirname "$target")"
        (sleep 1; open "http://localhost:8765/$(basename "$target")") &
    else
        cd "$target"
        (sleep 1; open "http://localhost:8765") &
    fi
    python3 -m http.server 8765
}

