            ;;
    esac
}

# Projects registry (Godspeed style)
cmd_projects() {
    local sub="${1:-list}"

    case "$sub" in
        list|status|"")
            chinna_project_status
            ;;
        clean)
            chinna_clear_old_projects
            ok "Registry cleaned"
            ;;
        history)
            shift
            chinna_project_history "$@"
            ;;
        note|notes)
            shift
            chinna_project_set_note "$@"
            ;;
        tag)
            shift
            chinna_project_add_tag "$@"
            ;;
        export)
            shift
            local fmt="${1:-json}"
            local out_file="$CHINNA_HOME/audits/projects-export-$(date +%Y%m%d-%H%M%S).${fmt}"
            mkdir -p "$(dirname "$out_file")"

            if [ "$fmt" = "csv" ]; then
                python3 - "$CHINNA_HOME/state/projects.json" > "$out_file" <<'PY'
import json, sys, csv, io
with open(sys.argv[1]) as f: data = json.load(f)
output = io.StringIO()
w = csv.writer(output)
w.writerow(['path','stack','port','url','status','updated'])
for p, i in data.get('projects',{}).items():
    w.writerow([p, i.get('stack'), i.get('port'), i.get('url'), i.get('status'), i.get('updated')])
print(output.getvalue())
PY
            else
                cp "$CHINNA_HOME/state/projects.json" "$out_file"
            fi
            ok "Exported to $out_file"
            ;;
        *)
            echo "Usage: chinna projects [list | clean | history <path> | note <path> <text> | tag <path> <tag> | export json|csv]"
            ;;
    esac
}

