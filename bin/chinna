# ═══════════════════════════════════════════════════════════════
# COMMAND: dashboard (web UI)
# ═══════════════════════════════════════════════════════════════
cmd_dashboard() {
    banner
    echo -e "   ${BOLD}${ORANGE}🌐 DASHBOARD${RESET}"; echo ""
    source "$CHINNA_LIB/server.sh" 2>/dev/null || { fail "server.sh not found"; return 1; }
    if is_dashboard_running 2>/dev/null; then
        info "Dashboard already running"
        open "http://localhost:${CHINNA_DASHBOARD_PORT:-7777}"
    else
        info "Starting dashboard on :${CHINNA_DASHBOARD_PORT:-7777}..."
        start_dashboard
        ok "Dashboard running at http://localhost:${CHINNA_DASHBOARD_PORT:-7777}"
        chinna_ok_toast "Dashboard" "Running at localhost:${CHINNA_DASHBOARD_PORT:-7777}" 2>/dev/null || true
    fi
    info "Press Ctrl+C to stop"
    wait $(cat "$CHINNA_HOME/dashboard.pid" 2>/dev/null) 2>/dev/null
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: app-install (one-click Mac app wrapper)
# ═══════════════════════════════════════════════════════════════
cmd_app_install() {
    banner
    echo -e "   ${BOLD}${ORANGE}🧩 INSTALL MAC APP${RESET}"; echo ""

    source "$CHINNA_LIB/server.sh" 2>/dev/null || { fail "server.sh not found"; return 1; }
    if ! is_dashboard_running 2>/dev/null; then
        info "Starting dashboard on :${CHINNA_DASHBOARD_PORT:-7777}..."
        start_dashboard
    fi

    local port="${CHINNA_DASHBOARD_PORT:-7777}"
    local url="http://localhost:${port}"
    local app_path="$HOME/Applications/Chinna.app"

    mkdir -p "$HOME/Applications"
    rm -rf "$app_path"
    osacompile -o "$app_path" -e "open location \"$url\"" >/dev/null 2>&1 || {
        fail "Failed to create app bundle"
        return 1
    }

    xattr -dr com.apple.quarantine "$app_path" 2>/dev/null || true
    open -a "$app_path" >/dev/null 2>&1 || true
    ok "Installed: $app_path"
    info "Launching dashboard app..."
}

cmd_app() {
    case "${1:-install}" in
        install|add|create|setup|"") cmd_app_install ;;
        *)
            warn "Unknown app subcommand: $1"
            info "Usage: chinna app install"
            return 1
            ;;
    esac
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: uninstall
# ═══════════════════════════════════════════════════════════════
cmd_uninstall() {
    banner
    echo -e "   ${BOLD}${R}🗑️  UNINSTALL${RESET}"; echo ""
    local purge=0
    case "${1:-}" in
        --purge|--full|-f) purge=1 ;;
    esac

    launchctl unload "$HOME/Library/LaunchAgents/com.chinna.daemon.plist" 2>/dev/null || true
    rm -f "$HOME/Library/LaunchAgents/com.chinna.daemon.plist"
    rm -f "$CHINNA_HOME/dashboard.pid" "$CHINNA_HOME/chinna.pid" 2>/dev/null || true

    if [ "$purge" -eq 1 ]; then
        warn "This will delete the entire Chinna home, caches, configs, and API keys."
        echo -ne "   ${Y}Type 'purge' to confirm:${RESET} "
        read -r yn
        if [ "$yn" = "purge" ]; then
            rm -rf "$CHINNA_HOME"
            sudo rm -f /usr/local/bin/chinna /opt/homebrew/bin/chinna 2>/dev/null || true
            ok "Chinna fully removed from this Mac"
        else
            info "Cancelled"
        fi
        return 0
    fi

    warn "This removes the app code but keeps your config, API keys, and user data."
    echo -ne "   ${Y}Type 'yes' to confirm:${RESET} "
    read -r yn
    if [ "$yn" = "yes" ]; then
        rm -rf "$CHINNA_HOME/bin" "$CHINNA_HOME/lib" "$CHINNA_HOME/dashboard" "$CHINNA_HOME/install" "$CHINNA_HOME/dashboard_server.py"
        sudo rm -f /usr/local/bin/chinna /opt/homebrew/bin/chinna 2>/dev/null || true
        ok "Chinna removed. Your data and keys were preserved."
    else
        info "Cancelled"
    fi
}

# ═══════════════════════════════════════════════════════════════
# INTENT DISPATCHER — maps resolved intent → command
# ═══════════════════════════════════════════════════════════════
dispatch_intent() {
    local intent="$1"
    local original="${2:-}"

    case "$intent" in
        clean)          cmd_clean ;;
        purge|slow)     cmd_purge ;;
        scan)           cmd_scan ;;
        dupes)          cmd_dupes ;;
        brew)           cmd_brew ;;
        free_ai)        cmd_free "$original" ;;
        pro_ai)         cmd_pro "$original" ;;
        voice)          cmd_listen ;;
        bot)            cmd_bot ;;
        preview)        cmd_preview ;;
        status)         cmd_status ;;
        ports)          cmd_ports ;;
        wifi)           cmd_wifi ;;
        kill_apps)      cmd_kill ;;
        git)            cmd_git ;;
        deploy)         deploy_project ;;
        run_project|stack_setup) run_project ;;
        env_setup)      generate_env . ;;
        publish)        cmd_publish ;;
        update)         cmd_update ;;
        notch)          cmd_notch ;;
        doctor)         cmd_doctor ;;
        config)         cmd_config ;;
        help)           show_help ;;
        unknown)
            echo ""
            warn "Couldn't understand: \"$original\""
            info "Sending to AI for interpretation..."
            cmd_pro "The user said: '$original'. Interpret what they want to do on their Mac and give a brief helpful response. If it's a Mac operation, tell them the chinna command to run (e.g. 'chinna clean', 'chinna purge')."
            ;;
    esac
}

# ═══════════════════════════════════════════════════════════════
# INTERACTIVE MENU
# ═══════════════════════════════════════════════════════════════
show_menu() {
    banner
    echo -e "   ${BOLD}What do you need? (type anything, I understand)${RESET}"
    echo ""
    echo -e "   ${ORANGE}1${RESET})  🧹  ${BOLD}Deep Clean${RESET}        ${D}Heavy cleanup (current powerful version)${RESET}"
    echo -e "   ${ORANGE}1a${RESET}) 🧼  ${BOLD}Clean Mac${RESET}         ${D}Godspeed-style full system clean${RESET}"
    echo -e "   ${ORANGE}1b${RESET}) 📦  ${BOLD}Clean Nodes${RESET}       ${D}Nuke all node_modules in ~/Documents & Downloads${RESET}"
    echo -e "   ${ORANGE}1c${RESET}) 🐳  ${BOLD}Clean Docker${RESET}      ${D}Prune everything${RESET}"
    echo -e "   ${ORANGE}1d${RESET}) 📁  ${BOLD}Clean Project${RESET}     ${D}Clean current dir build artifacts${RESET}"
    echo -e "   ${ORANGE}2${RESET})  🧠  ${BOLD}Purge RAM${RESET}         ${D}Free inactive memory${RESET}"
    echo -e "   ${ORANGE}3${RESET})  🔬  ${BOLD}Scan${RESET}              ${D}What's eating your disk${RESET}"
    echo -e "   ${ORANGE}4${RESET})  🔍  ${BOLD}Find Duplicates${RESET}   ${D}Hunt & kill duplicate files${RESET}"
    echo -e "   ${ORANGE}5${RESET})  🍺  ${BOLD}Dev Setup${RESET}         ${D}Homebrew + node + python + tools${RESET}"
    echo -e "   ${ORANGE}6${RESET})  🚀  ${BOLD}Run Project${RESET}       ${D}Auto-detect stack & run${RESET}"
    echo -e "   ${ORANGE}7${RESET})  🌐  ${BOLD}Deploy${RESET}            ${D}Vercel / Netlify / Railway${RESET}"
    echo -e "   ${ORANGE}8${RESET})  🤖  ${BOLD}Free AI Chat${RESET}      ${D}Llama 3.3 via OpenRouter${RESET}"
    echo -e "   ${ORANGE}9${RESET})  💎  ${BOLD}Pro AI Chat${RESET}       ${D}Claude / GPT via OpenRouter${RESET}"
    echo -e "   ${ORANGE}10${RESET}) 🎤  ${BOLD}Voice Mode${RESET}        ${D}Double-space=toggle, ENTER=record${RESET}"
    echo -e "   ${ORANGE}11${RESET}) 📡  ${BOLD}Telegram Bot${RESET}      ${D}Control Mac from phone${RESET}"
    echo -e "   ${ORANGE}12${RESET}) 📊  ${BOLD}Status${RESET}            ${D}Live disk/RAM/CPU dashboard${RESET}"
    echo -e "   ${ORANGE}13${RESET}) 💀  ${BOLD}Kill RAM Hogs${RESET}     ${D}Find & kill memory eaters${RESET}"
    echo -e "   ${ORANGE}14${RESET}) 🔌  ${BOLD}Ports${RESET}             ${D}What's running where${RESET}"
    echo -e "   ${ORANGE}15${RESET}) 📶  ${BOLD}WiFi Check${RESET}        ${D}Diagnostics + speed test${RESET}"
    echo -e "   ${ORANGE}16${RESET}) 🌿  ${BOLD}Git Commit${RESET}        ${D}AI-generated commit message${RESET}"
    echo -e "   ${ORANGE}17${RESET}) 🌐  ${BOLD}Preview HTML${RESET}      ${D}Local preview server${RESET}"
    echo -e "   ${ORANGE}18${RESET}) ⚙️   ${BOLD}Config${RESET}            ${D}API keys & settings${RESET}"
    echo -e "   ${ORANGE}19${RESET}) 🩺  ${BOLD}Doctor${RESET}            ${D}Health check${RESET}"
    echo -e "   ${ORANGE}20${RESET}) 🚀  ${BOLD}Start Daemon${RESET}      ${D}Run Chinna in background${RESET}"
    echo -e "   ${ORANGE}21${RESET}) 🌐  ${BOLD}Dashboard${RESET}         ${D}Premium web UI in browser${RESET}"
    echo -e "   ${ORANGE}22${RESET}) 🧩  ${BOLD}Plugins${RESET}           ${D}List / load / bootstrap plugins${RESET}"
    echo -e "   ${ORANGE}23${RESET}) 📍  ${BOLD}Notch Actions${RESET}     ${D}Menu-bar quick icons near camera area${RESET}"
    echo -e "   ${ORANGE}q${RESET})  ${D}Quit${RESET}"
    echo ""
    echo -ne "   ${BOLD}>${RESET} "
    if ! read -r input; then
        echo ""
        info "No interactive input available. Use: chinna help"
        return 0
    fi

    # Try numeric menu first
    case "$input" in
        1) cmd_clean ;;
        1a) cmd_clean_mac ;;
        1b) cmd_clean_nodes ;;
        1c) cmd_clean_docker ;;
        1d) cmd_clean_project ;;
        2) cmd_purge ;;
        3) cmd_scan ;;
        4) cmd_dupes ;;
        5) cmd_brew ;;
        6) run_project ;;
        7) deploy_project ;;
        8) echo -ne "  ${C}Prompt:${RESET} "; read -r p; cmd_free "$p" ;;
        9) echo -ne "  ${C}Prompt:${RESET} "; read -r p; cmd_pro "$p" ;;
        10) cmd_listen ;;
        11) cmd_bot ;;
        12) cmd_status ;;
        13) cmd_kill ;;
        14) cmd_ports ;;
        15) cmd_wifi ;;
        16) cmd_git ;;
        17) echo -ne "  File/dir (ENTER for pwd): "; read -r f; cmd_preview "$f" ;;
        18) cmd_config ;;
        19) cmd_doctor ;;
        20) cmd_start ;;
        21) cmd_dashboard ;;
        22) cmd_plugins ;;
        23) cmd_notch ;;
        q|Q) echo -e "  ${ORANGE}Later 👋${RESET}"; exit 0 ;;
        "")  show_menu ;;
        *)
            # Not a number — try intent engine
            local intent
            intent=$(resolve_intent "$input" 2>/dev/null || echo "unknown")
            dispatch_intent "$intent" "$input"
            ;;
    esac
}

# ═══════════════════════════════════════════════════════════════
# HELP
# ═══════════════════════════════════════════════════════════════
show_help() {
    banner
    cat <<HELP
   ${BOLD}USAGE${RESET}
     chinna                   Interactive menu
     chinna <command>         Direct command
     chinna "anything"        Natural language — I understand Telugu/Hindi/Tinglish

   ${BOLD}COMMANDS${RESET}
     ${C}clean${RESET}                  Deep clean (current powerful version)
     ${C}clean mac${RESET}              Godspeed-style full Mac cleanup
     ${C}clean nodes${RESET}            Nuke all node_modules in Documents/Downloads
     ${C}clean project${RESET}          Clean build artifacts in current dir
     ${C}purge${RESET}                  Purge inactive RAM
     ${C}scan${RESET}                   Show disk usage breakdown
     ${C}dupes${RESET} [path]           Find & delete duplicate files
     ${C}status${RESET}                 Live disk/RAM/CPU dashboard
     ${C}kill${RESET}                   Kill RAM-hogging processes
     ${C}ports${RESET}                  Show active ports
     ${C}wifi${RESET}                   WiFi diagnostics + speed test
     ${C}brew${RESET}                   Install Homebrew + dev tools
     ${C}run${RESET} [dir]              Auto-detect stack & run project
     ${C}deploy${RESET} [dir]           Deploy to Vercel/Netlify/Railway
     ${C}git${RESET}                    AI-generated git commit + push
     ${C}free${RESET} <prompt>          Free AI chat (Llama 3.3)
     ${C}pro${RESET} <prompt>           Paid AI chat (Claude/GPT)
     ${C}listen${RESET}                 Voice mode
     ${C}bot${RESET}                    Telegram remote control
     ${C}preview${RESET} [file/dir]     HTML preview server
     ${C}remind${RESET} <time> <msg>    Set reminder (5m, 2h, 30s)
     ${C}notify${RESET} <title> <msg>   Send Mac notification
     ${C}start${RESET}                  Start background daemon
     ${C}stop${RESET}                   Stop background daemon
     ${C}config${RESET}                 Set API keys
     ${C}publish${RESET}                Push update to GitHub
     ${C}doctor${RESET}                 Health check
     ${C}update${RESET}                 Self-update Chinna
    ${C}app-install${RESET}            Install Chinna as a 1-click Mac app
    ${C}notch${RESET}                  Install menu-bar quick actions (Purge/Clean/Update)
     ${C}uninstall${RESET} [--purge]    Remove Chinna app or fully purge everything

   ${BOLD}NATURAL LANGUAGE EXAMPLES${RESET}
     chinna "na mac slow aindhi"         → purge RAM + diagnostics
     chinna "stack build chei"           → detect stack + run project
     chinna "git lo pettu"               → AI commit + push
     chinna "deploy cheyyi"              → deploy to Vercel/Netlify
     chinna "duplicate files unnaya"     → find & delete dupes
     chinna "disk full aindhi"           → scan + clean options

   ${D}github.com/pichimail/chinna-go${RESET}

HELP
}

# ═══════════════════════════════════════════════════════════════
# MAIN DISPATCHER
# ═══════════════════════════════════════════════════════════════
main() {
    local cmd="${1:-}"

    # Internal daemon loop (called by LaunchAgent)
    [ "$cmd" = "_daemon_loop" ] && { daemon_loop; exit 0; }

    case "$cmd" in
        ""|menu)
            if [ ! -t 0 ]; then
                show_help
                return 0
            fi
            show_menu
            ;;
        clean|cleanmymac)           cmd_clean ;;
        "clean mac"|"clean-mac")    cmd_clean_mac ;;
        "clean nodes"|"clean-nodes") cmd_clean_nodes ;;
        "clean docker"|"clean-docker") cmd_clean_docker ;;
        "clean project"|"clean-project") cmd_clean_project ;;
        "clean light")              cmd_clean_light ;;
        purge|purgeram)             cmd_purge ;;
        scan)                       cmd_scan ;;
        status|stats)               cmd_status ;;
        dashboard|web|ui|panel)     cmd_dashboard ;;
        dupes|duplicates)           shift; cmd_dupes "$@" ;;
        kill)                       cmd_kill ;;
        ports)                      cmd_ports ;;
        whatsapp)
            shift; chinna_whatsapp "$@" ;;
        wifi|internet|network)      cmd_wifi ;;
        brew|devsetup)              cmd_brew ;;
        run|start_project)          shift; run_project "${1:-.}" ;;
        deploy)                     shift; deploy_project "${1:-.}" ;;
        git|commit)                 cmd_git ;;
        free)                       shift; cmd_free "$@" ;;
        pro)                        shift; cmd_pro "$@" ;;
        listen|voice)               cmd_listen ;;
        bot|telegram)               cmd_bot ;;
        preview|serve)              shift; cmd_preview "$@" ;;
        remind)                     shift; cmd_remind "$@" ;;
        notify)                     shift; cmd_notify "$@" ;;
        start)                      cmd_start ;;
        stop)                       cmd_stop ;;
        config|setup)               shift; cmd_config "$@" ;;
        model-set|model)            shift; chinna_model_set "$@" ;;
        setup-openrouter)           chinna_setup_openrouter ;;
        setup-anthropic)            chinna_setup_anthropic ;;
        publish)                    cmd_publish ;;
        doctor|health)              cmd_doctor ;;
        audit)                      cmd_audit ;;
        projects)                   shift; cmd_projects "$@" ;;
        plugin|plugins)             shift; cmd_plugins "$@" ;;
        update|upgrade)             shift; cmd_update "$@" ;;
        app-install|install-app)    cmd_app_install ;;
        app)                        shift; cmd_app "$@" ;;
        notch|quickbar|menubar)     cmd_notch ;;
        uninstall|remove)           shift; cmd_uninstall "$@" ;;
        help|-h|--help)             show_help ;;
        version|-v|--version)       echo "Chinna v$CHINNA_VERSION" ;;
        *)
            # Natural language fallback — run intent engine
            local intent
            intent=$(resolve_intent "$*" 2>/dev/null || echo "unknown")
            if [ "$intent" != "unknown" ]; then
                dispatch_intent "$intent" "$*"
            else
                warn "Unknown: \"$*\""
                info "Try: chinna help"
                exit 1
            fi
            ;;
    esac
}

main "$@"
