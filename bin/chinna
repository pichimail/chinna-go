# ═══════════════════════════════════════════════════════════════
# COMMAND: doctor
# ═══════════════════════════════════════════════════════════════
cmd_doctor() {
    banner
    echo -e "   ${BOLD}${TEAL}🩺 CHINNA DOCTOR${RESET}"; echo ""

    # Use printf for clean columns (Godspeed style)
    _check() {
        local name="$1" cmd="$2"
        if command -v "$cmd" >/dev/null 2>&1; then
            local ver
            ver=$($cmd --version 2>/dev/null | head -1 || $cmd -v 2>/dev/null | head -1 || echo "installed")
            printf "  %-16s %s\n" "$name" "${G}✓${RESET} $ver"
        else
            printf "  %-16s %s\n" "$name" "${R}✗ missing${RESET}"
        fi
    }

    section "Core CLI Tools"
    _check "git" git
    _check "jq" jq
    _check "node" node
    _check "python3" python3
    _check "docker" docker
    _check "bun" bun
    _check "go" go
    _check "rustc" rustc
    _check "flutter" flutter
    _check "rg" rg
    _check "fd" fd

    section "AI Configuration"
    chinna_load_env
    [ -n "${OPENROUTER_API_KEY:-}" ] && ok "OpenRouter key set" || warn "OpenRouter key missing → chinna config openrouter"
    [ -n "${ANTHROPIC_API_KEY:-}" ]  && ok "Anthropic key set"  || info "Anthropic optional"
    [ -n "${OPENAI_API_KEY:-}" ]     && ok "OpenAI key set"     || info "OpenAI optional (voice + fallback)"
    echo "  Active model:  ${ACTIVE_MODEL:-<not set>}"

    section "Automation & Dashboard"
    echo "  Automation mode: ${APPAUTOMATIONMODE:-off}"
    if pgrep -f "dashboard_server.py" >/dev/null 2>&1; then
        ok "Dashboard running → http://localhost:7777"
    else
        info "Dashboard not running (chinna dashboard)"
    fi

    section "System"
    printf "  %-16s %s\n" "macOS" "$(sw_vers -productVersion 2>/dev/null || echo unknown)"
    printf "  %-16s %s\n" "Arch" "$(uname -m)"
    printf "  %-16s %s\n" "Shell" "$SHELL"
    printf "  %-16s %s\n" "Chinna" "v$CHINNA_VERSION @ $CHINNA_HOME"

    section "Daemon"
    daemon_status 2>/dev/null || info "Daemon module not loaded"

    section "Project Registry"
    if [ -f "$CHINNA_HOME/state/projects.json" ]; then
        python3 - "$CHINNA_HOME/state/projects.json" <<'PY'
import json, sys, os
from datetime import datetime

f = sys.argv[1]
try:
    with open(f) as fp: data = json.load(fp)
except:
    data = {"projects": {}}

projs = data.get("projects", {})
print(f"  {len(projs)} projects tracked")

# Show top 4 most recent with notes/tags
sorted_p = sorted(projs.items(), key=lambda x: -x[1].get("updated", 0))[:4]
for path, info in sorted_p:
    short = path.replace(os.path.expanduser("~"), "~")
    stack = info.get("stack", "?")
    notes = info.get("notes", "")
    tags = info.get("tags", [])
    note_preview = (notes[:60] + "…") if notes else ""
    tag_str = " ".join(f"#{t}" for t in tags[:3]) if tags else ""
    print(f"    • {stack:12} {short}")
    if note_preview or tag_str:
        print(f"      {note_preview} {tag_str}")
PY
    else
        info "No project registry found yet"
    fi

    echo ""
    mac_notify "Chinna Doctor completed"
    mac_sound
}

# Audit Reporter (Godspeed PROMPT 6)
cmd_audit() {
    banner
    echo -e "   ${BOLD}${TEAL}📋 PROJECT AUDIT${RESET}\n"

    local timestamp
    timestamp=$(date +%Y%m%d-%H%M%S)
    local audit_dir="$CHINNA_HOME/audits"
    mkdir -p "$audit_dir"
    local report="$audit_dir/audit-$timestamp.txt"

    {
        echo "CHINNA V5 AUDIT REPORT"
        echo "Generated: $(date)"
        echo "Path: $(pwd)"
        echo "Stack: $(detect_stack .)"
        echo "========================================"
        echo ""

        echo "=== DISK USAGE (Top 20) ==="
        du -sh * 2>/dev/null | sort -hr | head -20
        echo ""

        echo "=== GIT STATUS ==="
        git status --short 2>/dev/null || echo "Not a git repo"
        echo ""

        echo "=== RECENT GIT LOG ==="
        git log --oneline -10 2>/dev/null || echo "No git history"
        echo ""

        echo "=== LARGE FILES (>5MB) ==="
        find . -type f -size +5M \
            -not -path '*/node_modules/*' \
            -not -path '*/.git/*' \
            -not -path '*/.venv/*' 2>/dev/null | head -30
        echo ""

        echo "=== TODO / FIXME / HACK ==="
        if command -v rg >/dev/null 2>&1; then
            rg -n --type-not binary '(TODO|FIXME|HACK|XXX)' . 2>/dev/null | head -50 || echo "None found"
        else
            echo "ripgrep not installed (install with: chinna brew)"
        fi
        echo ""

        if [ -f package.json ]; then
            echo "=== NPM AUDIT ==="
            npm audit --json 2>/dev/null | head -80 || echo "npm audit completed"
            echo ""
        fi

        if [ -f requirements.txt ] || [ -f pyproject.toml ]; then
            echo "=== PYTHON SYNTAX CHECK ==="
            python3 -m py_compile **/*.py 2>&1 | head -20 || echo "No Python syntax errors"
            echo ""
        fi

        echo "=== CHINNA CONFIG ==="
        chinna_config_status 2>/dev/null || true
        echo ""

    } | tee "$report"

    echo ""
    ok "Audit saved to: $report"
    mac_notify "Audit complete"
    mac_sound
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: update
# ═══════════════════════════════════════════════════════════════
cmd_update() {
    banner
    echo -e "   ${BOLD}${ORANGE}⬆️  UPDATE${RESET}"; echo ""
    local remote_ver
    remote_ver="$(remote_version)"
    [ -n "$remote_ver" ] || { fail "Could not fetch remote version"; return 1; }

    if ! version_gt "$remote_ver" "$CHINNA_VERSION"; then
        info "Already on v$CHINNA_VERSION — force-refreshing app files anyway..."
    else
        info "Available: v$CHINNA_VERSION → v$remote_ver"
    fi

    remote_ver="${remote_ver:-$CHINNA_VERSION}"

    info "This update keeps your data, config, and API keys intact."

    if [ "${1:-}" = "--apply" ] || [ "${1:-}" = "-y" ] || [ "${1:-}" = "--yes" ]; then
        apply_update "$remote_ver"
        return $?
    fi

    local choice
    choice=$(chinna_toast_action \
        "Chinna Update" \
        "Force-refresh to latest v${remote_ver}?\nYour files, config, and API keys will stay intact." \
        "Update Now|Later" 2>/dev/null)
    [ -n "$choice" ] || choice="Later"

    if [ "$choice" = "Update Now" ]; then
        apply_update "$remote_ver"
    else
        info "Update postponed"
    fi
}

# ═══════════════════════════════════════════════════════════════
# COMMAND: notch (menu bar quick actions near camera area)
# ═══════════════════════════════════════════════════════════════
cmd_notch() {
    banner
    echo -e "   ${BOLD}${ORANGE}📍 NOTCH / MENU QUICK ACTIONS${RESET}"; echo ""

    if command -v install_notch_quick_actions >/dev/null 2>&1; then
        if install_notch_quick_actions; then
            ok "Quick actions installed for menu bar (SwiftBar)"
            info "Open SwiftBar to see 🟠 near the notch/menu area"
            open -a SwiftBar >/dev/null 2>&1 || true
            return 0
        fi
    fi

    warn "SwiftBar is required for notch-adjacent dynamic quick icons."
    if command -v brew >/dev/null 2>&1; then
        info "Installing SwiftBar via Homebrew cask..."
        brew install --cask swiftbar >/dev/null 2>&1 || { fail "SwiftBar install failed"; return 1; }
        install_notch_quick_actions || true
        open -a SwiftBar >/dev/null 2>&1 || true
        ok "SwiftBar installed and Chinna quick actions configured"
    else
        info "Install SwiftBar manually, then run: chinna notch"
    fi
}

