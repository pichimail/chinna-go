{
  "manifest_version": 3,
  "name": "Chinna — AI Browser Companion",
  "version": "2.1.0",
  "description": "Tab-aware AI assistant with terminal access, Mac music control, AI music generation, multi-tab analysis, form autofill, explain-selection, copy-as-Markdown, translate, TL;DR, and chat history — powered by your local Chinna-Go.",
  "permissions": [
    "activeTab", "scripting", "tabs", "downloads", "storage",
    "sidePanel", "tabCapture", "offscreen", "contextMenus", "cookies"
  ],
  "host_permissions": ["<all_urls>", "http://localhost:7777/*", "http://127.0.0.1:7777/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Chinna Companion" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" }
    },
    "new-chat": {
      "suggested_key": { "default": "Ctrl+Shift+O", "mac": "Command+Shift+O" },
      "description": "Start a new Chinna chat"
    }
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["inject.js"],
    "matches": ["<all_urls>"]
  }]
}
