{
  "manifest_version": 3,
  "name": "Chinna — AI Tab Assistant",
  "version": "1.0.0",
  "description": "Conversational AI that watches your current tab: summarize, scrape, ask anything, screenshot, record, and clone any page into one responsive HTML file.",
  "permissions": ["activeTab", "scripting", "tabs", "downloads", "storage", "sidePanel", "tabCapture", "offscreen"],
  "host_permissions": ["<all_urls>", "http://localhost:7777/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Open Chinna Assistant" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" }
    }
  }
}
